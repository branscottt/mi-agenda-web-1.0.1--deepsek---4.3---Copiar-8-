# ============================================================================
# Agenda Pro — Variables de Entorno
# ============================================================================
# Copia este archivo a .env.local para desarrollo local.
# En producción, estas variables se configuran en el panel del hosting
# (Vercel, Railway, etc.) o en el servidor como variables de sistema.
#
# Convención:
#   .env.local  → Desarrollo local (NO se sube a git)
#   Sistema     → Producción (configurado en el hosting)
# ============================================================================

# ============================================================================
# SUPABASE — Credenciales del proyecto (anónimas / public)
# ============================================================================
# Estas claves son públicas (seguras para el frontend).
# La seguridad real está en las RLS policies de Supabase.
# Obtén estos valores en: Supabase Dashboard > Settings > API
SUPABASE_URL=https://dfcfimipkfhitlsyixqu.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...tu-key-completa-aqui

# ============================================================================
# ENTORNO — Modo de ejecución
# ============================================================================
# development | production | staging
# Controla: inicialización de analytics, logging, rate limits, etc.
APP_ENV=development

# ============================================================================
# POSTHOG — Analytics (gratuito, 1M eventos/mes)
# ============================================================================
# Regístrate gratis en: https://posthog.com/signup
# Luego obtén tu API Key en: Project Settings > Project API Key
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Host de PostHog (nube: https://app.posthog.com, self-hosted: tu URL)
POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# MERCADO PAGO — Pagos (producción)
# ============================================================================
# Access Token de producción (NUNCA compartir ni subir a git)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx

# ============================================================================
# SUPABASE — Edge Functions (despliegue)
# ============================================================================
# Solo necesarias si despliegas Edge Functions manualmente
# SUPABASE_ACCESS_TOKEN=...

# ============================================================================
# SENTRY — Monitoreo de errores (opcional, reemplazar DSN en código)
# ============================================================================
# Configurado directamente en src/shared/infrastructure/sentry.js
# No requiere variable de entorno.
